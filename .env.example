# Copy this file to .env and fill in your free API keys, then
# `export $(cat .env | xargs)` before running any channel (or use a
# tool like python-dotenv). All of these are FREE tiers, no credit card.
#
# If you already run the sibling peace_reels_automation project, PIXABAY_API_KEY
# and PEXELS_API_KEY can just be copied from its .env — same var names, same
# free-tier keys work for both projects. GROQ_API_KEY is unique to this
# project (peace_reels_automation doesn't use Groq).

# Free at https://console.groq.com -> API Keys
GROQ_API_KEY=

# Free at https://pixabay.com/accounts/register/ -> https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Free at https://www.pexels.com/api/ -> instant, no approval wait
PEXELS_API_KEY=

# Free (signup required) at https://enter.pollinations.ai is for Pollinations,
# NOT this one -- Agnes AI's own signup is at https://agnes-ai.com. Used for a
# couple of real AI-generated video clips per episode (core/visuals.py
# fetch_hybrid_stock_agnes_videos); optional -- leave blank and every channel
# still runs on 100% stock video.
AGNES_API_KEY=


# Path to the OAuth client_secret.json you download from Google Cloud Console
# (see core/upload.py docstring for the one-time setup steps). This project
# splits its 11 channels across 3 Google Cloud OAuth projects to stay under
# YouTube's daily upload quota: client_secret_a.json (4 ch), _b.json (4 ch),
# _c.json (3 ch) — see scripts/registry.py.
YT_CLIENT_SECRET_FILE=client_secret_a.json
